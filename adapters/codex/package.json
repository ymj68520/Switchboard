  "private": true,
  "description": "Switchboard adapter for Codex CLI: phase-model managed session launcher (pre-alpha).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "phase-model": "./bin/phase-model.js"
  },
  "files": [
    "bin",
    "dist",
    "docs"
  ],
  "engines": {
    "node": ">=22.4.0"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ymj68520/Switchboard.git",
    "directory": "adapters/codex"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",

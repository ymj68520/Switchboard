{
  "name": "switchboard",
  "version": "0.1.0",
  "private": true,
  "description": "The intelligent model router for AI coding agents.",
  "workspaces": [
    "packages/*",
    "adapters/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "smoke:opencode": "node scripts/opencode-live-smoke.mjs",
    "smoke:opencode-handoff": "node scripts/opencode-handoff-smoke.mjs",
    "smoke:opencode-handoff-det": "node scripts/opencode-handoff-det-smoke.mjs",
    "smoke:opencode-validator": "node scripts/opencode-validator-live.mjs",
    "smoke:opencode-context": "node scripts/opencode-context-smoke.mjs",
    "release:claude": "node scripts/claude-release.mjs"
  }
}
